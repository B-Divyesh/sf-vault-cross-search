{
  "name": "vault-cross-search",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "tauri": "tauri",
    "build:app": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "test:serve-site": "npm run build:site && npm run preview:site -- --host 127.0.0.1",
    "test": "vitest run src && playwright test && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run src",
    "typecheck": "tsc --noEmit",
    "preview:site": "vite preview --config vite.site.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.4",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
