{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault Cross Search",
  "version": "0.1.5",
  "identifier": "in.sociobot.vault-cross-search",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [{
      "title": "Vault Cross Search",
      "width": 1180,
      "height": 760,
      "minWidth": 760,
      "minHeight": 560,
      "center": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; connect-src https://api.sociobot.in" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Search several local KeePass vaults without merging them.",
    "longDescription": "A local, session-only federated metadata index for KeePass-compatible vaults.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "appimage": { "bundleMediaFramework": false } }
  }
}
